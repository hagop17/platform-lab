# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required for the default groq provider (https://console.groq.com).
GROQ_API_KEY=

# LLM provider: "groq" (default) or "anthropic".
LLM_PROVIDER=groq

# Required only if LLM_PROVIDER=anthropic (and the anthropic extra is installed).
ANTHROPIC_API_KEY=

# Docker build arg (not a runtime var): set true to install the anthropic extra
# in the image. Default false.
WITH_ANTHROPIC=false

# Optional: where the RAG ChromaDB index lives. Defaults to ~/.tpr-rag/chroma_data.
# TPR_RAG_DATA_DIR=

# Optional: Prometheus base URL. Defaults to the compose-internal
# http://prometheus:9090; override for host-local dev.
# PROMETHEUS_URL=http://localhost:9090
